<!--
  Nexus design tokens (references/UI.md, section 9).
  Views reference only the *Brush keys through DynamicResource; hex values live here and nowhere else.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <!-- Surfaces and text -->
            <Color x:Key="BackgroundColor">#0E0F11</Color>
            <Color x:Key="SurfaceSidebarColor">#15171A</Color>
            <Color x:Key="SurfaceColor">#1C1F23</Color>
            <Color x:Key="SurfaceRaisedColor">#262A2F</Color>
            <Color x:Key="BorderColor">#353A40</Color>
            <Color x:Key="TextPrimaryColor">#F2F3F5</Color>
            <Color x:Key="TextSecondaryColor">#A9AFB7</Color>
            <Color x:Key="TextDisabledColor">#80868E</Color>

            <!-- Brand: chrome only, never state or data -->
            <Color x:Key="BrandPrimaryColor">#C8102E</Color>
            <Color x:Key="BrandAccentColor">#E01E3C</Color>
            <Color x:Key="OnBrandColor">#FFFFFF</Color>

            <!-- Semantic state: always paired with an icon and text -->
            <Color x:Key="StatusSuccessColor">#3DD68C</Color>
            <Color x:Key="StatusWarningColor">#F5A524</Color>
            <Color x:Key="StatusErrorColor">#FF6B5E</Color>
            <Color x:Key="StatusInfoColor">#5B9BF0</Color>
            <Color x:Key="OnStatusColor">#0E0F11</Color>

            <!-- Data palette: no red, no semantic colors -->
            <Color x:Key="Data1Color">#8DA4C4</Color>
            <Color x:Key="Data2Color">#2BB3A3</Color>
            <Color x:Key="Data3Color">#A58BF0</Color>
            <Color x:Key="Data4Color">#C9A66B</Color>
            <Color x:Key="Data5Color">#8A9099</Color>

            <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
            <SolidColorBrush x:Key="SurfaceSidebarBrush" Color="{StaticResource SurfaceSidebarColor}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
            <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />
            <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimaryColor}" />
            <SolidColorBrush x:Key="BrandAccentBrush" Color="{StaticResource BrandAccentColor}" />
            <SolidColorBrush x:Key="OnBrandBrush" Color="{StaticResource OnBrandColor}" />
            <SolidColorBrush x:Key="StatusSuccessBrush" Color="{StaticResource StatusSuccessColor}" />
            <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarningColor}" />
            <SolidColorBrush x:Key="StatusErrorBrush" Color="{StaticResource StatusErrorColor}" />
            <SolidColorBrush x:Key="StatusInfoBrush" Color="{StaticResource StatusInfoColor}" />
            <SolidColorBrush x:Key="OnStatusBrush" Color="{StaticResource OnStatusColor}" />
            <SolidColorBrush x:Key="Data1Brush" Color="{StaticResource Data1Color}" />
            <SolidColorBrush x:Key="Data2Brush" Color="{StaticResource Data2Color}" />
            <SolidColorBrush x:Key="Data3Brush" Color="{StaticResource Data3Color}" />
            <SolidColorBrush x:Key="Data4Brush" Color="{StaticResource Data4Color}" />
            <SolidColorBrush x:Key="Data5Brush" Color="{StaticResource Data5Color}" />

            <!-- Fluent overrides: focus ring, text fields, DataGrid -->
            <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="{StaticResource BrandAccentColor}" />
            <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="{StaticResource BackgroundColor}" />
            <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource SurfaceRaisedColor}" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource BorderColor}" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{StaticResource TextDisabledColor}" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource BrandAccentColor}" />
            <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{StaticResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="{StaticResource SurfaceRaisedColor}" />
            <SolidColorBrush x:Key="DataGridColumnHeaderBackgroundBrush" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="DataGridColumnHeaderHoveredBackgroundBrush" Color="{StaticResource SurfaceRaisedColor}" />
            <SolidColorBrush x:Key="DataGridColumnHeaderPressedBackgroundBrush" Color="{StaticResource SurfaceRaisedColor}" />
            <SolidColorBrush x:Key="DataGridColumnHeaderForegroundBrush" Color="{StaticResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="DataGridGridLinesBrush" Color="{StaticResource BorderColor}" />
            <SolidColorBrush x:Key="DataGridRowBackgroundBrush" Color="{StaticResource BackgroundColor}" />
            <SolidColorBrush x:Key="DataGridCellBackgroundBrush" Color="Transparent" />
            <SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush" Color="{StaticResource SurfaceRaisedColor}" />
            <SolidColorBrush x:Key="DataGridRowSelectedHoveredBackgroundBrush" Color="{StaticResource SurfaceRaisedColor}" />
            <SolidColorBrush x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" Color="{StaticResource SurfaceRaisedColor}" />
            <SolidColorBrush x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" Color="{StaticResource SurfaceRaisedColor}" />
            <x:Double x:Key="DataGridRowSelectedBackgroundOpacity">1</x:Double>
            <x:Double x:Key="DataGridRowSelectedHoveredBackgroundOpacity">1</x:Double>
            <x:Double x:Key="DataGridRowSelectedUnfocusedBackgroundOpacity">1</x:Double>
            <x:Double x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundOpacity">1</x:Double>
            <Color x:Key="DataGridRowHoveredBackgroundColor">#262A2F</Color>
            <SolidColorBrush x:Key="DataGridCellFocusVisualPrimaryBrush" Color="{StaticResource BrandAccentColor}" />
            <SolidColorBrush x:Key="DataGridCellFocusVisualSecondaryBrush" Color="Transparent" />
            <SolidColorBrush x:Key="DataGridCurrencyVisualPrimaryBrush" Color="Transparent" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Shape: 2 px on controls, 0 px on panels and overlays -->
    <CornerRadius x:Key="ControlCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>

    <!--
      Barlow family (SIL OFL), embedded in Assets/Fonts. The condensed cuts are addressed by file:
      looking them up by folder matches "Barlow SemiBold" instead (covered by HeadlessUiTests).
    -->
    <FontFamily x:Key="TextFont">avares://erp_inteligente/Assets/Fonts#Barlow</FontFamily>
    <FontFamily x:Key="TitleFont">avares://erp_inteligente/Assets/Fonts/BarlowCondensed-SemiBold.ttf#Barlow Condensed SemiBold</FontFamily>
    <FontFamily x:Key="TabularFont">avares://erp_inteligente/Assets/Fonts/BarlowSemiCondensed-Regular.ttf#Barlow Semi Condensed</FontFamily>
    <FontFamily x:Key="TabularStrongFont">avares://erp_inteligente/Assets/Fonts/BarlowSemiCondensed-SemiBold.ttf#Barlow Semi Condensed SemiBold</FontFamily>
</ResourceDictionary>
