<!--
  Nexus icon set: solid geometric shapes on a 16 px grid, square terminals.
  Drawn for this app; no third-party icon library and no emoji (references/NEGATIVAS_WEB.md, section 2).
  Keys are "Icon.<Name>" so NavigationItem.IconKey can resolve them.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
