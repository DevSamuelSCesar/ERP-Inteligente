<!--
  Nexus control styles (references/UI.md, section 9; references/NEGATIVAS_WEB.md).
  No shadows, no gradients, no transitions; 2 px corners on controls, 0 px on panels.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base typography -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style Selector="TextBlock.title">
        <Setter Property="FontFamily" Value="{StaticResource TitleFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="26" />
    </Style>
    <Style Selector="TextBlock.boardTitle">
        <Setter Property="FontFamily" Value="{StaticResource TitleFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="17" />
    </Style>
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.secondary">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.tabular">
        <Setter Property="FontFamily" Value="{StaticResource TabularFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFeatures" Value="+tnum" />
    </Style>
    <Style Selector="TextBlock.totalValue">
        <Setter Property="FontFamily" Value="{StaticResource TabularStrongFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontFeatures" Value="+tnum" />
    </Style>
    <Style Selector="TextBlock.success">
        <Setter Property="Foreground" Value="{DynamicResource StatusSuccessBrush}" />
    </Style>
    <Style Selector="TextBlock.warning">
        <Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}" />
    </Style>
    <Style Selector="TextBlock.error">
        <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
    </Style>

    <!-- Rules: 1 px separators between regions -->
    <Style Selector="Rectangle.rule">
        <Setter Property="Fill" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Height" Value="1" />
    </Style>
    <Style Selector="Rectangle.vrule">
        <Setter Property="Fill" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Width" Value="1" />
    </Style>

    <!-- Icons -->
    <Style Selector="PathIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="PathIcon.success">
        <Setter Property="Foreground" Value="{DynamicResource StatusSuccessBrush}" />
    </Style>
    <Style Selector="PathIcon.warning">
        <Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}" />
    </Style>
    <Style Selector="PathIcon.error">
        <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
    </Style>
    <Style Selector="PathIcon.info">
        <Setter Property="Foreground" Value="{DynamicResource StatusInfoBrush}" />
    </Style>
    <!-- The only animation in the app: the progress indicator of the status line -->
    <Style Selector="PathIcon.spinning">
        <Setter Property="RenderTransform" Value="rotate(0deg)" />
        <Style.Animations>
            <Animation Duration="0:0:1" IterationCount="Infinite">
                <KeyFrame Cue="0%">
                    <Setter Property="RotateTransform.Angle" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="RotateTransform.Angle" Value="360" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Buttons: base theme in Styles/ButtonTheme.axaml; here only the class variants -->
    <Style Selector="Button PathIcon">
        <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
    </Style>

    <!-- Primary: the single brand-red action of an area -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnBrandBrush}" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource BrandAccentBrush}" />
    </Style>
    <!-- Disabled primary: no fill, plain rule and dimmed text; red only when the action is available -->
    <Style Selector="Button.primary:disabled">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
    </Style>

    <!-- Accept: success fill with dark text -->
    <Style Selector="Button.accept">
        <Setter Property="Background" Value="{DynamicResource StatusSuccessBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StatusSuccessBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnStatusBrush}" />
    </Style>
    <Style Selector="Button.accept:pointerover /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource StatusSuccessBrush}" />
        <Setter Property="Opacity" Value="0.88" />
    </Style>

    <!-- Neutral: outlined, used by Reject and secondary actions -->
    <Style Selector="Button.neutral">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource TextDisabledBrush}" />
    </Style>

    <!-- Navigation buttons of the menu column: icon left, text right, red bar when active -->
    <Style Selector="RadioButton.nav">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Name="Root" Background="{TemplateBinding Background}" Height="40" ColumnDefinitions="3,*">
                    <Rectangle Name="Indicator" Grid.Column="0" Fill="Transparent" />
                    <ContentPresenter Grid.Column="1"
                                      Margin="13,0,12,0"
                                      VerticalAlignment="Center"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Foreground="{TemplateBinding Foreground}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.nav:pointerover /template/ Grid#Root">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    </Style>
    <Style Selector="RadioButton.nav:checked">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="RadioButton.nav:checked /template/ Grid#Root">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    </Style>
    <Style Selector="RadioButton.nav:checked /template/ Rectangle#Indicator">
        <Setter Property="Fill" Value="{DynamicResource BrandPrimaryBrush}" />
    </Style>
    <Style Selector="RadioButton.nav PathIcon">
        <Setter Property="Foreground" Value="{Binding $parent[RadioButton].Foreground}" />
    </Style>

    <!-- Tabs of query screens: text with a 2 px bottom rule when active -->
    <Style Selector="RadioButton.tab">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Name="Root" Background="{TemplateBinding Background}" RowDefinitions="*,2">
                    <ContentPresenter Margin="12,6" Content="{TemplateBinding Content}"
                                      Foreground="{TemplateBinding Foreground}" />
                    <Rectangle Name="Indicator" Grid.Row="1" Fill="Transparent" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.tab:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="RadioButton.tab:checked">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="RadioButton.tab:checked /template/ Rectangle#Indicator">
        <Setter Property="Fill" Value="{DynamicResource BrandPrimaryBrush}" />
    </Style>

    <!-- Text fields -->
    <Style Selector="TextBox">
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
    </Style>

    <!-- Panels: flat, square, 1 px rule -->
    <Style Selector="Border.board">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Border.location">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="10,4" />
    </Style>

    <!-- DataGrid: dense rows, tabular figures, horizontal rules only -->
    <Style Selector="DataGrid">
        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="RowHeight" Value="28" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="CanUserResizeColumns" Value="True" />
        <Setter Property="CanUserSortColumns" Value="True" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="HeadersVisibility" Value="Column" />
    </Style>
    <Style Selector="DataGridCell">
        <Setter Property="FontFamily" Value="{StaticResource TabularFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFeatures" Value="+tnum" />
        <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style Selector="DataGridColumnHeader">
        <Setter Property="FontFamily" Value="{StaticResource TabularStrongFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="30" />
    </Style>

    <!-- Totals strip: one line of label/value pairs between two rules -->
    <Style Selector="ItemsControl.totals">
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </Setter>
    </Style>

    <!-- Tooltips and menus follow the flat surfaces -->
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
    </Style>
</Styles>
