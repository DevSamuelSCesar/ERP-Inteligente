{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "receive_goods",
  "description": "Registra a entrada de itens em um endereço (normalmente a doca).",
  "type": "object",
  "additionalProperties": false,
  "required": ["sku", "qty", "location"],
  "properties": {
    "sku": { "anyOf": [ { "type": "string", "pattern": "^[A-Z]{3}-[0-9]{3}$", "maxLength": 7 }, { "type": "string", "pattern": "^\\$[a-z][a-z0-9_]{0,31}$", "maxLength": 33 } ], "description": "SKU do produto (ABC-123) ou referência a um passo anterior." },
    "qty": { "type": "integer", "minimum": 1, "maximum": 100000, "description": "Quantidade recebida." },
    "location": { "anyOf": [ { "type": "string", "pattern": "^[A-Z]{1,4}-[0-9]{2}(-[0-9]{2})?$", "maxLength": 10 }, { "type": "string", "pattern": "^\\$[a-z][a-z0-9_]{0,31}$", "maxLength": 33 } ], "description": "Endereço de destino da entrada." },
    "lot": { "type": "string", "minLength": 1, "maxLength": 30, "description": "Código do lote." },
    "expires_on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "maxLength": 10, "description": "Validade no formato AAAA-MM-DD." },
    "inbound_order": { "type": "string", "minLength": 1, "maxLength": 40, "description": "Pedido de entrada." }
  }
}
