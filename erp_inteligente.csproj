<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- SQL scripts applied by DatabaseBootstrapper when a new database is created -->
  <ItemGroup>
    <EmbeddedResource Include="db\schema.sql" LogicalName="Nexus.Db.schema.sql" />
    <EmbeddedResource Include="db\security.sql" LogicalName="Nexus.Db.security.sql" />
    <EmbeddedResource Include="db\seed.sql" LogicalName="Nexus.Db.seed.sql" />
    <EmbeddedResource Include="db\optimize.sql" LogicalName="Nexus.Db.optimize.sql" />
    <EmbeddedResource Include="db\migrations\*.sql" LogicalName="Nexus.Db.migrations.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- DSL v1 JSON Schemas of the plan operations (Core/Engine); reused as LLM tool schemas in feature 3 -->
  <ItemGroup>
    <EmbeddedResource Include="Core\Engine\Schemas\v1\*.schema.json" LogicalName="Nexus.Dsl.v1.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- System prompt of the Planner (Core/Planner) -->
  <ItemGroup>
    <EmbeddedResource Include="Core\Planner\Prompts\system.md" LogicalName="Nexus.Planner.system.md" />
  </ItemGroup>

  <!-- Built-in skills (Core/Skills); the key is the frontmatter name, so the resource name only needs the prefix -->
  <ItemGroup>
    <EmbeddedResource Include="skills\*\SKILL.md" LogicalName="Nexus.Skills.%(RecursiveDir)SKILL.md" />
  </ItemGroup>

  <!-- Knowledge base of the RAG (Core/Knowledge); knowledge/README.md is documentation, not content -->
  <ItemGroup>
    <EmbeddedResource Include="knowledge\*.md" Exclude="knowledge\README.md" LogicalName="Nexus.Knowledge.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The test project lives under tests/ and must not be compiled into the app. -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <AvaloniaXaml Remove="tests\**" />
    <None Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nexus.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.14" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <PackageReference Include="JsonSchema.Net" Version="9.6.0" />
  </ItemGroup>
</Project>
