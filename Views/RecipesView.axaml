<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:erp_inteligente.ViewModels"
             xmlns:m="using:erp_inteligente.Models"
             x:Class="erp_inteligente.Views.RecipesView"
             x:DataType="vm:RecipesViewModel">

    <!-- Read-only query screen: filter, totals strip, DataGrid (references/UI.md, section 7) -->
    <Grid RowDefinitions="Auto,Auto,*">
        <TextBox Grid.Row="0" Width="400" HorizontalAlignment="Left"
                 Text="{Binding FilterText}" PlaceholderText="{Binding FilterPlaceholder}" MaxLength="100" />
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <Rectangle Classes="rule" />
            <ItemsControl Classes="totals" ItemsSource="{Binding Totals}" />
        </StackPanel>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}">
            <DataGrid.Columns>
                <DataGridTextColumn x:DataType="m:RecipeRow" Header="Nome" Binding="{Binding Name}" Width="180" />
                <DataGridTextColumn x:DataType="m:RecipeRow" Header="Skill" Binding="{Binding Skill}" Width="120" />
                <DataGridTextColumn x:DataType="m:RecipeRow" Header="Descrição" Binding="{Binding Description}" Width="*" />
                <DataGridTextColumn x:DataType="m:RecipeRow" Header="Usos" Binding="{Binding Uses}" Width="80" />
                <DataGridTextColumn x:DataType="m:RecipeRow" Header="Status" Binding="{Binding Status}" Width="90" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
