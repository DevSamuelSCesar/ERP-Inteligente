<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:erp_inteligente.ViewModels"
             xmlns:m="using:erp_inteligente.Models"
             x:Class="erp_inteligente.Views.RecipesView"
             x:DataType="vm:RecipesViewModel">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SavePromotionCommand}" />
        <KeyBinding Gesture="Escape" Command="{Binding CancelPromotionCommand}" />
    </UserControl.KeyBindings>

    <!-- Receitas (feature 7): table on top, detail below with "Usar receita" or the promotion editor -->
    <Grid RowDefinitions="Auto,Auto,Auto,220,*">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*">
            <RadioButton Classes="tab" GroupName="RecipeTabs" Content="Ativas" IsChecked="{Binding ShowActive}" />
            <RadioButton Grid.Column="1" Classes="tab" GroupName="RecipeTabs" Content="Candidatas" IsChecked="{Binding ShowCandidates}" />
            <RadioButton Grid.Column="2" Classes="tab" GroupName="RecipeTabs" Content="Suspensas e despromovidas" IsChecked="{Binding ShowInactive}" />
            <TextBox Grid.Column="3" Width="320" HorizontalAlignment="Left" Margin="16,0,0,0"
                     Text="{Binding FilterText}" PlaceholderText="Filtrar por nome, descrição ou skill" MaxLength="100" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0" IsVisible="{Binding IsReadOnly}">
            <PathIcon Classes="info" Data="{StaticResource Icon.Info}" Width="14" Height="14" />
            <TextBlock Classes="secondary" VerticalAlignment="Center"
                       Text="Promover, suspender e despromover receitas é do supervisor." />
        </StackPanel>

        <!-- Feedback: a line with icon and text, never a toast -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0" IsVisible="{Binding HasFeedback}">
            <PathIcon Classes="success" Data="{StaticResource Icon.Accept}" Width="14" Height="14" IsVisible="{Binding FeedbackIsSuccess}" />
            <PathIcon Classes="error" Data="{StaticResource Icon.Error}" Width="14" Height="14" IsVisible="{Binding FeedbackIsError}" />
            <TextBlock Text="{Binding Feedback}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>

        <Panel Grid.Row="3" Margin="0,12,0,0">
            <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" IsEnabled="{Binding IsViewing}">
                <DataGrid.Columns>
                    <DataGridTextColumn x:DataType="vm:RecipeListRow" Header="Nome" Binding="{Binding Name}" Width="200" />
                    <DataGridTextColumn x:DataType="vm:RecipeListRow" Header="Skill" Binding="{Binding SkillText}" Width="120" />
                    <DataGridTextColumn x:DataType="vm:RecipeListRow" Header="Descrição" Binding="{Binding Description}" Width="*" />
                    <DataGridTextColumn x:DataType="vm:RecipeListRow" Header="Usos" Binding="{Binding Uses}" Width="70" />
                    <DataGridTextColumn x:DataType="vm:RecipeListRow" Header="Falhas" Binding="{Binding Failures}" Width="70" />
                    <DataGridTextColumn x:DataType="vm:RecipeListRow" Header="Situação" Binding="{Binding StatusText}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Classes="secondary" Margin="0,40,0,0" HorizontalAlignment="Center" IsVisible="{Binding IsEmpty}"
                       Text="Nenhuma receita nesta lista." />
        </Panel>

        <ScrollViewer Grid.Row="4" Margin="0,14,0,0">
            <StackPanel>
                <!-- Detail of the selected recipe -->
                <StackPanel IsVisible="{Binding IsViewing}">
                    <StackPanel IsVisible="{Binding HasSelection}">
                        <Rectangle Classes="rule" />
                        <TextBlock Classes="secondary" Margin="0,10,0,4" Text="{Binding SelectedMeta}" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,6" IsVisible="{Binding HasSelectedReason}">
                            <PathIcon Classes="warning" Data="{StaticResource Icon.Warning}" Width="14" Height="14"
                                      Margin="0,2,10,0" VerticalAlignment="Top" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedReason}" TextWrapping="Wrap" />
                        </Grid>
                        <SelectableTextBlock Text="{Binding SelectedRow.Description, FallbackValue=''}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Classes="label" Text="Passos" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding StepLines}" Margin="0,0,0,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Classes="tabular" Text="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12" IsVisible="{Binding CanManage}">
                            <Button Classes="neutral" Command="{Binding StartPromotionCommand}" IsVisible="{Binding CanPromoteSelected}"
                                    ToolTip.Tip="Dar nome e descrição e liberar o uso (Alt+R)">
                                <AccessText Text="P_romover" />
                            </Button>
                            <Button Classes="neutral" Command="{Binding SuspendCommand}" IsVisible="{Binding CanSuspendSelected}"
                                    ToolTip.Tip="Pausar o uso até reativar (Alt+S)">
                                <AccessText Text="_Suspender" />
                            </Button>
                            <Button Classes="neutral" Command="{Binding ReactivateCommand}" IsVisible="{Binding CanReactivateSelected}"
                                    ToolTip.Tip="Revalidar com os valores de exemplo e ativar (Alt+A)">
                                <AccessText Text="Re_ativar" />
                            </Button>
                            <Button Classes="neutral" Command="{Binding DemoteCommand}" IsVisible="{Binding CanDemoteSelected}"
                                    ToolTip.Tip="Retirar de uso; fica no histórico (Alt+D)">
                                <AccessText Text="_Despromover" />
                            </Button>
                        </StackPanel>

                        <!-- Use the recipe: values, preview, send. No LLM. -->
                        <StackPanel IsVisible="{Binding CanUseSelected}">
                            <Rectangle Classes="rule" />
                            <TextBlock Classes="boardTitle" Text="Usar receita" Margin="0,10,0,10" />
                            <ItemsControl ItemsSource="{Binding Fields}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RecipeFieldViewModel">
                                        <Grid ColumnDefinitions="200,*" Margin="0,0,0,8">
                                            <TextBlock Classes="label" Text="{Binding Label}" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" MaxWidth="420" HorizontalAlignment="Left" MinWidth="240"
                                                     Text="{Binding Value}" PlaceholderText="{Binding Hint}" MaxLength="2000" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="200,4,0,12">
                                <Button Classes="neutral" Command="{Binding PreviewCommand}" ToolTip.Tip="Valida e simula sem gravar (Alt+P)">
                                    <AccessText Text="_Pré-visualizar" />
                                </Button>
                                <Button Classes="primary" Command="{Binding SubmitCommand}" ToolTip.Tip="Envia o plano pré-visualizado (Alt+E)">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <AccessText Text="_Enviar plano" VerticalAlignment="Center" />
                                        <PathIcon Data="{StaticResource Icon.Send}" Width="14" Height="14" />
                                    </StackPanel>
                                </Button>
                                <PathIcon Classes="spinning info" Data="{StaticResource Icon.Progress}" Width="14" Height="14"
                                          VerticalAlignment="Center" IsVisible="{Binding IsBusy}" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Issues}" Margin="0,0,0,10" IsVisible="{Binding HasIssues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="m:PlanIssue">
                                        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,6">
                                            <PathIcon Classes="error" Data="{StaticResource Icon.Error}" Width="14" Height="14"
                                                      Margin="0,2,10,0" VerticalAlignment="Top" />
                                            <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Classes="board" HorizontalAlignment="Left" MinWidth="560" MaxWidth="900" Margin="0,0,0,16"
                                    IsVisible="{Binding HasPreview}">
                                <StackPanel>
                                    <Rectangle Height="2" Fill="{DynamicResource StatusWarningBrush}" IsVisible="{Binding PreviewIsCritical}" />
                                    <Grid ColumnDefinitions="*,Auto" Margin="14,10">
                                        <TextBlock Classes="boardTitle" Text="Pré-visualização" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Classes="secondary" Text="nada foi gravado" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*" Margin="14,0,14,10">
                                        <PathIcon Classes="warning" Data="{StaticResource Icon.Warning}" Width="14" Height="14"
                                                  Margin="0,2,10,0" VerticalAlignment="Top" IsVisible="{Binding PreviewIsCritical}" />
                                        <TextBlock Grid.Column="1" Text="{Binding PreviewRiskText}" TextWrapping="Wrap" />
                                    </Grid>
                                    <ContentControl Content="{Binding PreviewEffect}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <ContentControl Content="{Binding Result}" />
                    </StackPanel>
                </StackPanel>

                <!-- Promotion editor (recipe.manage only) -->
                <StackPanel IsVisible="{Binding IsPromoting}">
                    <Rectangle Classes="rule" />
                    <TextBlock Classes="boardTitle" Text="Promover receita" Margin="0,10,0,10" />
                    <Grid ColumnDefinitions="140,*" Margin="0,0,0,10">
                        <TextBlock Classes="label" Text="Nome" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Width="320" HorizontalAlignment="Left" Text="{Binding PromoteName}" MaxLength="40"
                                 PlaceholderText="letras minúsculas e _, ex.: guardar_da_doca" />
                    </Grid>
                    <Grid ColumnDefinitions="140,*">
                        <TextBlock Classes="label" Text="Descrição" VerticalAlignment="Top" Margin="0,6,0,0" />
                        <TextBox Grid.Column="1" Text="{Binding PromoteDescription}" TextWrapping="Wrap" MinHeight="64" MaxLength="300"
                                 PlaceholderText="O que a receita faz, em uma frase. O Nexus usa esta frase para reconhecer o pedido." />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="140,12,0,0">
                        <Button Classes="primary" Command="{Binding SavePromotionCommand}" ToolTip.Tip="Promover (Ctrl+S)">
                            <TextBlock Text="Promover" />
                        </Button>
                        <Button Classes="neutral" Command="{Binding CancelPromotionCommand}" ToolTip.Tip="Sair sem promover (Esc)">
                            <TextBlock Text="Cancelar" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
