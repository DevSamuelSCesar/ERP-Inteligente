<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:erp_inteligente.ViewModels"
             xmlns:m="using:erp_inteligente.Models"
             x:Class="erp_inteligente.Views.AuditView"
             x:DataType="vm:AuditViewModel">

    <!-- Read-only query screen: filter, totals strip, DataGrid (references/UI.md, section 7) -->
    <Grid RowDefinitions="Auto,Auto,*">
        <TextBox Grid.Row="0" Width="400" HorizontalAlignment="Left"
                 Text="{Binding FilterText}" PlaceholderText="{Binding FilterPlaceholder}" MaxLength="100" />
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <Rectangle Classes="rule" />
            <ItemsControl Classes="totals" ItemsSource="{Binding Totals}" />
        </StackPanel>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}">
            <DataGrid.Columns>
                <DataGridTextColumn x:DataType="m:AuditRow" Header="Data e hora" Binding="{Binding AtText}" Width="140" />
                <DataGridTextColumn x:DataType="m:AuditRow" Header="Usuário" Binding="{Binding User}" Width="170" />
                <DataGridTextColumn x:DataType="m:AuditRow" Header="Ação" Binding="{Binding Action}" Width="170" />
                <DataGridTextColumn x:DataType="m:AuditRow" Header="Detalhe" Binding="{Binding Detail}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
