<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:erp_inteligente.ViewModels"
             x:Class="erp_inteligente.Views.SkillProposalView"
             x:DataType="vm:SkillProposalViewModel">

    <!-- Skill drafted by the Nexus (references/UI.md, section 5.3): the full text before anything is saved -->
    <Border Classes="board" HorizontalAlignment="Left" VerticalAlignment="Top" MinWidth="620" MaxWidth="960">
        <StackPanel>
            <Grid ColumnDefinitions="Auto,*" Margin="14,10,14,10">
                <PathIcon Data="{StaticResource Icon.Skills}" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="boardTitle" Text="{Binding Title}" VerticalAlignment="Center" />
            </Grid>
            <Rectangle Classes="rule" />

            <ContentControl Content="{Binding Reason}" Margin="14,10,14,0"
                            IsVisible="{Binding Reason, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <Grid ColumnDefinitions="120,*" Margin="14,10,14,0">
                <TextBlock Classes="label" Text="Quando usar" />
                <SelectableTextBlock Grid.Column="1" Text="{Binding Description}" TextWrapping="Wrap" />
            </Grid>

            <Grid ColumnDefinitions="120,*" Margin="14,10,14,0">
                <TextBlock Classes="label" Text="Operações" />
                <StackPanel Grid.Column="1">
                    <TextBlock Classes="secondary" Text="Nenhuma: só orientação." IsVisible="{Binding !HasOperations}" />
                    <ItemsControl ItemsSource="{Binding Operations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SkillOperationLine">
                                <Grid ColumnDefinitions="200,*,90" Height="24">
                                    <TextBlock Classes="tabular" Text="{Binding Name}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Classes="secondary" Text="{Binding RiskText}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>

            <TextBlock Classes="label" Text="Instruções" Margin="14,10,14,6" />
            <Border Background="{DynamicResource BackgroundBrush}" Margin="14,0,14,10" Padding="12,10">
                <ScrollViewer MaxHeight="320">
                    <SelectableTextBlock Name="Body" Text="{Binding Body}" TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>
            <Rectangle Classes="rule" />

            <!-- Requester's decision -->
            <Panel Margin="14,10,14,10" MinHeight="32">
                <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsPending}">
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontWeight="Medium" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Classes="accept" Margin="10,0,0,0"
                            Command="{Binding ConfirmCommand}" ToolTip.Tip="Salvar a skill (Alt+C)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource Icon.Accept}" Width="14" Height="14" />
                            <AccessText Text="_Confirmar" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Classes="neutral" Margin="8,0,0,0"
                            Command="{Binding DiscardCommand}" ToolTip.Tip="Descartar sem gravar (Alt+D)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource Icon.Reject}" Width="12" Height="12" />
                            <AccessText Text="_Descartar" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" IsVisible="{Binding IsSubmitting}">
                    <PathIcon Classes="spinning info" Data="{StaticResource Icon.Progress}" Width="14" Height="14" />
                    <TextBlock Classes="secondary" Text="{Binding StatusText}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsDone}">
                    <TextBlock Classes="secondary" Text="{Binding StatusText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>

                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center" IsVisible="{Binding IsFailed}">
                    <PathIcon Classes="error" Data="{StaticResource Icon.Error}" Width="14" Height="14" Margin="0,2,10,0" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" TextWrapping="Wrap" />
                </Grid>
            </Panel>
        </StackPanel>
    </Border>
</UserControl>
