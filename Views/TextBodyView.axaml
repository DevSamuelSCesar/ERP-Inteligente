<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:erp_inteligente.ViewModels"
             x:Class="erp_inteligente.Views.TextBodyView"
             x:DataType="vm:TextBodyViewModel">
    <Grid ColumnDefinitions="Auto,*">
        <!-- Errors are a line with icon and text; no tinted box (references/UI.md, section 9.2) -->
        <PathIcon Classes="error" Data="{StaticResource Icon.Error}" Margin="0,2,8,0" VerticalAlignment="Top"
                  IsVisible="{Binding IsError}" />
        <PathIcon Classes="warning" Data="{StaticResource Icon.Warning}" Margin="0,2,8,0" VerticalAlignment="Top"
                  IsVisible="{Binding IsWarning}" />
        <!-- Runs are built in code-behind from Segments: entities highlighted with the data palette (UI.md, 4.2) -->
        <SelectableTextBlock Name="Body" Grid.Column="1" TextWrapping="Wrap" />
    </Grid>
</UserControl>
