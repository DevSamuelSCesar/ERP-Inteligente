<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:erp_inteligente.ViewModels"
        x:Class="erp_inteligente.Views.LoginWindow"
        x:DataType="vm:LoginViewModel"
        Title="Nexus"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterScreen">

    <!-- Login: same flat surfaces, square panel, one brand-red action (references/UI.md, section 9) -->
    <StackPanel Margin="32,28,32,32" Spacing="0">
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,20">
            <PathIcon Data="{StaticResource Icon.Nexus}" Width="22" Height="22"
                      Foreground="{DynamicResource BrandPrimaryBrush}" />
            <TextBlock Classes="title" Text="Nexus" VerticalAlignment="Center" />
        </StackPanel>
        <Rectangle Classes="rule" Margin="0,0,0,18" />

        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,16" IsVisible="{Binding HasNotice}">
            <PathIcon Classes="info" Data="{StaticResource Icon.Progress}" Width="14" Height="14"
                      Margin="0,2,10,0" VerticalAlignment="Top" />
            <TextBlock Grid.Column="1" Text="{Binding Notice}" TextWrapping="Wrap" />
        </Grid>

        <TextBlock Classes="label" Text="Usuário" Margin="0,0,0,4" />
        <TextBox Name="UsernameBox" Text="{Binding Username}" MaxLength="64"
                 IsEnabled="{Binding !IsBusy}" Margin="0,0,0,14" />

        <TextBlock Classes="label" Text="Senha" Margin="0,0,0,4" />
        <TextBox Name="PasswordBox" Text="{Binding Password}" PasswordChar="•" MaxLength="1024"
                 IsEnabled="{Binding !IsBusy}" Margin="0,0,0,14" />

        <!-- Errors are a line with icon and text, no tinted box -->
        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,14" IsVisible="{Binding HasError}">
            <PathIcon Classes="error" Data="{StaticResource Icon.Error}" Width="14" Height="14"
                      Margin="0,2,10,0" VerticalAlignment="Top" />
            <TextBlock Grid.Column="1" Text="{Binding ErrorText}" TextWrapping="Wrap" />
        </Grid>

        <Button Classes="primary" HorizontalAlignment="Stretch" Height="36" IsDefault="True"
                Command="{Binding LoginCommand}">
            <Panel>
                <TextBlock Text="Entrar" IsVisible="{Binding !IsBusy}" />
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBusy}">
                    <PathIcon Classes="spinning" Data="{StaticResource Icon.Progress}" Width="14" Height="14" />
                    <TextBlock Text="Verificando" />
                </StackPanel>
            </Panel>
        </Button>
    </StackPanel>
</Window>
