<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:erp_inteligente.ViewModels"
             x:Class="erp_inteligente.Views.DraftPlanView"
             x:DataType="vm:DraftPlanViewModel">

    <UserControl.Styles>
        <Style Selector="Grid.stepLine > TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <!-- Proposal of the Planner: same board as a stored plan (references/UI.md, section 5.1); nothing is written yet -->
    <Border Classes="board" HorizontalAlignment="Left" VerticalAlignment="Top" MinWidth="620" MaxWidth="960">
        <StackPanel>
            <Rectangle Height="2" Fill="{DynamicResource StatusWarningBrush}" IsVisible="{Binding IsCritical}" />

            <Grid ColumnDefinitions="*,Auto" Margin="14,10,14,10">
                <TextBlock Classes="boardTitle" Text="{Binding Title}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <PathIcon Classes="warning" Data="{StaticResource Icon.Warning}" Width="14" Height="14"
                              IsVisible="{Binding IsCritical}" />
                    <TextBlock Classes="warning" FontWeight="Medium" Text="{Binding RiskText}" IsVisible="{Binding IsCritical}" />
                    <TextBlock Classes="secondary" Text="{Binding RiskText}" IsVisible="{Binding !IsCritical}" />
                </StackPanel>
            </Grid>
            <Rectangle Classes="rule" />

            <!-- Why this path and what was assumed (references/UI.md, section 5.1) -->
            <ContentControl Content="{Binding Rationale}" Margin="14,10,14,0"
                            IsVisible="{Binding Rationale, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <StackPanel Margin="14,10,14,0" Spacing="4" IsVisible="{Binding HasAssumptions}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Classes="info" Data="{StaticResource Icon.Info}" Width="14" Height="14" />
                    <TextBlock Classes="label" Text="Suposições" VerticalAlignment="Center" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Assumptions}" Margin="20,0,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <Grid Classes="stepLine" ColumnDefinitions="180,100,84,100,120,*" Margin="14,8,14,4">
                <TextBlock Grid.Column="0" Classes="label" Text="Operação" />
                <TextBlock Grid.Column="1" Classes="label" Text="Qtd" />
                <TextBlock Grid.Column="2" Classes="label" Text="SKU" />
                <TextBlock Grid.Column="3" Classes="label" Text="De / Endereço" />
                <TextBlock Grid.Column="4" Classes="label" Text="Para" />
                <TextBlock Grid.Column="5" Classes="label" Text="Observação" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Steps}" Margin="14,0,14,10">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlanStepLine">
                        <Grid Classes="stepLine" ColumnDefinitions="180,100,84,100,120,*" Height="26">
                            <TextBlock Grid.Column="0" Text="{Binding Operation}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Classes="tabular" Text="{Binding Quantity}" />
                            <TextBlock Grid.Column="2" Classes="tabular" Text="{Binding Sku}" />
                            <TextBlock Grid.Column="3" Classes="tabular" Text="{Binding From}" />
                            <TextBlock Grid.Column="4" Classes="tabular" Text="{Binding To}" />
                            <TextBlock Grid.Column="5" Text="{Binding Note}" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding Note}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Simulated effect, rendered like the post-execution summary -->
            <Rectangle Classes="rule" IsVisible="{Binding Effect, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Classes="label" Text="Efeito simulado" Margin="14,10,14,0"
                       IsVisible="{Binding Effect, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <ContentControl Content="{Binding Effect}" IsVisible="{Binding Effect, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <Rectangle Classes="rule" />

            <!-- Requester's decision -->
            <Panel Margin="14,10,14,10" MinHeight="32">
                <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsPending}">
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontWeight="Medium" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Classes="accept" Margin="10,0,0,0"
                            Command="{Binding ConfirmCommand}" ToolTip.Tip="Confirmar e enviar ao motor (Alt+C)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource Icon.Accept}" Width="14" Height="14" />
                            <AccessText Text="_Confirmar" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Classes="neutral" Margin="8,0,0,0"
                            Command="{Binding DiscardCommand}" ToolTip.Tip="Descartar sem gravar (Alt+D)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource Icon.Reject}" Width="12" Height="12" />
                            <AccessText Text="_Descartar" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" IsVisible="{Binding IsSubmitting}">
                    <PathIcon Classes="spinning info" Data="{StaticResource Icon.Progress}" Width="14" Height="14" />
                    <TextBlock Classes="secondary" Text="{Binding StatusText}" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Classes="secondary" Text="{Binding StatusText}" VerticalAlignment="Center" IsVisible="{Binding IsDone}" />

                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center" IsVisible="{Binding IsFailed}">
                    <PathIcon Classes="error" Data="{StaticResource Icon.Error}" Width="14" Height="14" Margin="0,2,10,0" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" TextWrapping="Wrap" />
                </Grid>
            </Panel>
        </StackPanel>
    </Border>
</UserControl>
