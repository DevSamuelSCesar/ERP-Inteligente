<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:erp_inteligente.ViewModels"
             xmlns:m="using:erp_inteligente.Models"
             x:Class="erp_inteligente.Views.OrdersView"
             x:DataType="vm:OrdersViewModel">

    <!-- Read-only query screen: filter, totals strip, DataGrid (references/UI.md, section 7) -->
    <Grid RowDefinitions="Auto,Auto,*">
        <TextBox Grid.Row="0" Width="400" HorizontalAlignment="Left"
                 Text="{Binding FilterText}" PlaceholderText="{Binding FilterPlaceholder}" MaxLength="100" />
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <Rectangle Classes="rule" />
            <ItemsControl Classes="totals" ItemsSource="{Binding Totals}" />
        </StackPanel>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}">
            <DataGrid.Columns>
                <DataGridTextColumn x:DataType="m:OrderRow" Header="Número" Binding="{Binding Number}" Width="150" />
                <DataGridTextColumn x:DataType="m:OrderRow" Header="Tipo" Binding="{Binding Kind}" Width="90" />
                <DataGridTextColumn x:DataType="m:OrderRow" Header="Fornecedor / cliente" Binding="{Binding Party}" Width="*" />
                <DataGridTextColumn x:DataType="m:OrderRow" Header="Linhas" Binding="{Binding Lines}" Width="80" />
                <DataGridTextColumn x:DataType="m:OrderRow" Header="Unidades" Binding="{Binding Units}" Width="90" />
                <DataGridTextColumn x:DataType="m:OrderRow" Header="Status" Binding="{Binding Status}" Width="120" />
                <DataGridTextColumn x:DataType="m:OrderRow" Header="Previsto" Binding="{Binding DueOnText}" Width="110" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
