<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:erp_inteligente.ViewModels"
             xmlns:s="using:erp_inteligente.Services"
             x:Class="erp_inteligente.Views.OptionsView"
             x:DataType="vm:OptionsViewModel"
             x:Name="Root">
    <!-- Suggested next steps: neutral buttons with an arrow, never brand red (references/UI.md, section 4.3) -->
    <ItemsControl ItemsSource="{Binding Options}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="s:NexusOption">
                <Button Classes="neutral" ToolTip.Tip="{Binding Request}"
                        Command="{Binding #Root.((vm:OptionsViewModel)DataContext).ChooseCommand}"
                        CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                        <PathIcon Data="{StaticResource Icon.Arrow}" Width="12" Height="12" />
                    </StackPanel>
                </Button>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
